# =============================================================================
# Base environment for Docker Compose services
# =============================================================================
# These are the default values used by docker-compose.yml.
# In worktrees, worktree-env adds a per-worktree offset (1-99) to each
# numeric port and appends -<worktree-name> to string values, allowing
# multiple compositions to run simultaneously.
#
# Requirements for base ports:
#   - Must end in 00 (2+ trailing zeros) for full 100-offset range
#   - Ending in 0 (1 trailing zero) triggers a warning (only 10 offsets)
#   - No trailing zeros causes an error (no room for offsets)
# =============================================================================

COMPOSE_PROJECT_NAME=scope-mt-app

MONGODB_PORT=27000
REDIS_PORT=6300
LOWKEY_VAULT_PORT=8400
AZURITE_BLOB_PORT=10100
AZURITE_QUEUE_PORT=10200
AZURITE_TABLE_PORT=10300
API_PORT=3100
JUDGE_PORT=3200
TOKEN_MANAGER_PORT=3300
PORTAL_PORT=5100
DEVPROXY_COPILOT_API_PORT=18800
GATEWAY_API_PORT=18900
DEVPROXY_CLAUDE_API_PORT=19000
