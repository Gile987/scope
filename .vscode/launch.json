{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Docker Dev Copilot",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "GITHUB_TOKEN=$(gh auth token) pnpm docker:dev:copilot"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
