FROM node:22.22.0-slim AS builder

RUN corepack enable && corepack prepare pnpm@10.29.1 --activate

WORKDIR /app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY tsconfig.base.json ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/judge/package.json ./packages/judge/

RUN pnpm install --frozen-lockfile

COPY packages/shared/tsconfig.json ./packages/shared/
COPY packages/shared/src ./packages/shared/src/
COPY packages/judge/tsconfig.json ./packages/judge/
COPY packages/judge/src ./packages/judge/src/

RUN pnpm --filter shared build && pnpm --filter judge build

FROM node:22.22.0-slim

RUN corepack enable && corepack prepare pnpm@10.29.1 --activate

WORKDIR /app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/judge/package.json ./packages/judge/

RUN pnpm install --frozen-lockfile --prod

COPY --from=builder /app/packages/shared/dist ./packages/shared/dist/
COPY --from=builder /app/packages/judge/dist ./packages/judge/dist/

# Copy criteria definitions
COPY config/criteria ./config/criteria/

WORKDIR /app/packages/judge

EXPOSE 80

ENV PORT=80
ENV CRITERIA_DIR=/app/config/criteria
ENV JUDGE_STRATEGY=bundled
ENV JUDGE_MAX_PARALLELISM=3
ENV FEEDBACK_MAX_CRITERIA=1
ENV FEEDBACK_DESCENDANT_GUARD=true

CMD ["node", "dist/index.js"]
