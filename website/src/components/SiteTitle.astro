---
import config from 'virtual:starlight/user-config';
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex">
	<span class="scope-logo" aria-hidden="true">
		<svg
			class="scope-logo__svg"
			width="24"
			height="24"
			viewBox="0 0 24 24"
			fill="none"
			role="img"
			aria-label={config.logo?.alt}
		>
			{/* Single ECG pulse. It stays put; its amplitude
			    oscillates low <-> high around the baseline, so the
			    wave "beats" without moving sideways. */}
			<g
				class="scope-logo__wave"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
			>
				<path d="M22 12h-4l-3 9L9 3l-3 9H2" />
			</g>
		</svg>
	</span>
	<span class:list={{ 'sr-only': config.logo?.replacesTitle }} translate="no">
		{siteTitle}
	</span>
</a>

<style>
	@layer starlight.core {
		.site-title {
			align-items: center;
			gap: var(--sl-nav-gap);
			font-size: var(--sl-text-h4);
			font-weight: 600;
			color: var(--sl-color-text-accent);
			text-decoration: none;
			white-space: nowrap;
			min-width: 0;
		}
		span {
			overflow: hidden;
		}
		.scope-logo {
			display: block;
			height: calc(var(--sl-nav-height) - 2 * var(--sl-nav-pad-y));
			aspect-ratio: 1 / 1;
			color: var(--sl-color-text-accent);
		}
		.scope-logo__svg {
			display: block;
			width: 100%;
			height: 100%;
			overflow: hidden;
		}
		/* The waveform stays put and breathes: a slow, gentle sway
		   that eases up and down for a calm, relaxing rhythm. */
		.scope-logo__wave {
			transform-box: view-box;
			transform-origin: center;
			animation: scope-wave-beat 1.1s ease-in-out infinite alternate;
		}
		@keyframes scope-wave-beat {
			from {
				transform: scaleY(0.55);
			}
			to {
				transform: scaleY(1.05);
			}
		}
		@media (prefers-reduced-motion: reduce) {
			.scope-logo__wave {
				animation: none;
			}
		}
	}
</style>
