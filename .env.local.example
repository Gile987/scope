# =============================================================================
# Local-only environment overrides
# =============================================================================
# Copy this file to .env.local and fill in the values. This file is loaded
# by the `api` service in docker-compose.yml (and is gitignored), so it is
# the right place for credentials that must NOT be committed and must NOT
# be touched by worktree-env (which regenerates .env from .env.base on
# every invocation).
#
# Usage:
#   cp .env.local.example .env.local
#   # edit .env.local, then:
#   pnpm docker:up:copilot   # or any other docker:* / docker:dev:* script
# =============================================================================

# ---------------------------------------------------------------------------
# Azure AI Foundry — portal AI features (criteria / prompt-feature /
# task-prompt generation in the API).
#
# When both variables below are set, the API uses Azure AI Foundry for fast,
# dedicated inference and ignores the GitHub Models fallback. Leave blank to
# keep using GitHub Models (slow public endpoint; fine for local dev).
#
# IMPORTANT: the endpoint MUST include the `/models` path segment — that is
# the Foundry inference data plane. The Azure portal often shows the resource
# URL WITHOUT the path; you need to add it yourself:
#
#   ✅ https://<your-foundry-resource>.services.ai.azure.com/models
#   ❌ https://<your-foundry-resource>.services.ai.azure.com   (missing /models)
#
# Without `/models`, every chat/completions call returns HTTP 404
# "Resource not found".
# ---------------------------------------------------------------------------
AZURE_AI_INFERENCE_ENDPOINT=
AZURE_AI_INFERENCE_API_KEY=

# ---------------------------------------------------------------------------
# Model / deployment name used for the portal AI features.
# - On Foundry: must match the deployment name on the Foundry resource
#   (e.g. gpt-4.1, gpt-4.1-mini, gpt-4o).
# - On GitHub Models: any model the GitHub Models endpoint exposes.
# Defaults to gpt-4.1 inside the API when unset.
# ---------------------------------------------------------------------------
LLM_MODEL=

# ---------------------------------------------------------------------------
# Authentication & RBAC — Microsoft Entra ID
#
# Local Portal auth uses the same real IdP path as every other environment.
# Docker Compose maps these AUTH_* values into Vite's required VITE_AUTH_*
# variables for the Portal container; do not add a dev bypass.
#
# Leave these unset to use the Portal Docker profile's Entra Local defaults.
# Entra Local is a Microsoft Entra ID emulator with seeded SPA/API apps; it is
# local-only and intentionally insecure, so use it only on localhost. When
# overriding these values manually, use the actual `ENTRA_LOCAL_PORT` generated
# in `.env` for this worktree.
# ---------------------------------------------------------------------------
AUTH_PROVIDER=entra
AUTH_AUTHORITY=
AUTH_API_CLIENT_ID=
AUTH_CLIENT_ID=
AUTH_SCOPES=
AUTH_KNOWN_AUTHORITIES=
AUTH_BOOTSTRAP_ADMINS=
AUTH_BOOTSTRAP_TENANTS=
