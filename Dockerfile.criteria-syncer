FROM node:22.22.0-slim AS builder

RUN corepack enable && corepack prepare pnpm@10.29.1 --activate

WORKDIR /app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY tsconfig.base.json ./
COPY packages/criteria-syncer/package.json ./packages/criteria-syncer/

RUN pnpm install --frozen-lockfile

COPY packages/criteria-syncer/tsconfig.json ./packages/criteria-syncer/
COPY packages/criteria-syncer/src ./packages/criteria-syncer/src/

RUN pnpm --filter criteria-syncer build

FROM node:22.22.0-slim

RUN corepack enable && corepack prepare pnpm@10.29.1 --activate

WORKDIR /app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/criteria-syncer/package.json ./packages/criteria-syncer/

RUN pnpm install --frozen-lockfile --prod

COPY --from=builder /app/packages/criteria-syncer/dist ./packages/criteria-syncer/dist/

WORKDIR /app/packages/criteria-syncer

CMD ["node", "dist/index.js"]
