              "stdio",
            ],
            "type": "string",
          },
          "url": {
            "type": "string",
          },
          "version": {
            "type": "string",
          },
        },
        "type": "object",
      },
      "UpdatePromptFeatureInput": {
        "properties": {
          "prompt": {
            "type": "string",
          },
        },
        "type": "object",
      },
      "UpdateReportTemplateInput": {
        "properties": {
          "description": {
            "type": "string",
          },
          "model": {
            "type": "string",
          },
          "name": {
            "type": "string",
          },
          "systemPrompt": {
            "$ref": "#/components/schemas/ReportTemplateSystemPrompt",
          },
          "timeoutMs": {
            "exclusiveMinimum": 0,
            "type": "integer",
          },
          "trigger": {
            "$ref": "#/components/schemas/ReportTrigger",
          },
          "userPrompt": {
            "type": "string",
          },
        },
        "type": "object",
      },
      "ValidateKeyInput": {
        "properties": {
          "token": {
            "type": "string",
          },
        },
        "required": [
          "token",
        ],
        "type": "object",
      },
    },
  },
  "info": {
    "description": "REST API for the Scope platform — benchmarking AI coding agents",
    "title": "Scope API",
    "version": "1.0.0",
  },
  "openapi": "3.1.0",
  "paths": {
    "/about": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "buildTime": {
                      "type": "string",
                    },
                    "description": {
                      "type": "string",
                    },
                    "environment": {
                      "type": "string",
                    },
                    "name": {
                      "type": "string",
                    },
                    "version": {
                      "type": "string",
                    },
                    "workers": {
                      "items": {
                        "type": "string",
                      },
                      "type": "array",
                    },
                  },
                  "required": [
                    "name",
                    "version",
                    "buildTime",
                    "environment",
                    "description",
                    "workers",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Success",
          },
        },
        "summary": "API metadata",
        "tags": [
          "System",
        ],
      },
    },
