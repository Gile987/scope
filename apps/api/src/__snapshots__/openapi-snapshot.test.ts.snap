    "/api/v1/mcp/servers": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/McpServerResponse",
                  },
                  "type": "array",
                },
              },
            },
            "description": "Success",
          },
        },
        "summary": "List MCP servers",
        "tags": [
          "MCP Servers",
        ],
      },
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "_id": {
                    "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
                    "type": "string",
                  },
                  "args": {
                    "items": {
                      "type": "string",
                    },
                    "type": "array",
                  },
                  "command": {
                    "type": "string",
                  },
                  "description": {
                    "type": "string",
                  },
                  "env": {
                    "additionalProperties": {
                      "type": "string",
                    },
                    "type": "object",
                  },
                  "headers": {
                    "items": {
                      "$ref": "#/components/schemas/McpServerHeader",
                    },
                    "type": "array",
                  },
                  "name": {
                    "type": "string",
                  },
                  "sessionMode": {
                    "enum": [
                      "stateful",
                      "stateless",
                    ],
                    "type": "string",
                  },
                  "type": {
                    "enum": [
                      "sse",
                      "http",
                      "stdio",
                    ],
                    "type": "string",
                  },
                  "url": {
                    "type": "string",
                  },
                  "version": {
                    "type": "string",
                  },
                },
                "required": [
                  "_id",
                  "name",
                  "type",
                ],
                "type": "object",
              },
            },
          },
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/McpServerResponse",
                },
              },
            },
            "description": "Success",
          },
        },
        "summary": "Create MCP server",
        "tags": [
          "MCP Servers",
        ],
      },
    },
