ARG COPILOT_CLI_VERSION

# Windows Server Core with Node.js for the Copilot CLI worker
FROM mcr.microsoft.com/windows/servercore:ltsc2022 AS base

# Install Node.js LTS
ARG NODE_VERSION=24.2.0
SHELL ["powershell", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]
RUN Invoke-WebRequest -Uri "https://nodejs.org/dist/v$env:NODE_VERSION/node-v$env:NODE_VERSION-win-x64.zip" -OutFile node.zip ; \
    Expand-Archive node.zip -DestinationPath C:\ ; \
    Rename-Item "C:\node-v$env:NODE_VERSION-win-x64" "C:\nodejs" ; \
    Remove-Item node.zip
RUN setx /M PATH "C:\nodejs;$env:PATH"

# Install pnpm via corepack
RUN C:\nodejs\node.exe C:\nodejs\npx.cmd corepack enable
RUN C:\nodejs\node.exe C:\nodejs\npx.cmd corepack prepare pnpm@10.29.1 --activate

# Install Git (required by coding agents)
RUN Invoke-WebRequest -Uri "https://github.com/git-for-windows/git/releases/download/v2.47.2.windows.1/MinGit-2.47.2-64-bit.zip" -OutFile git.zip ; \
    Expand-Archive git.zip -DestinationPath "C:\git" ; \
    Remove-Item git.zip
RUN setx /M PATH "C:\git\cmd;C:\git\mingw64\bin;$env:PATH"

# Install GitHub Copilot CLI globally
ARG COPILOT_CLI_VERSION
RUN C:\nodejs\npm.cmd install -g "@github/copilot@$env:COPILOT_CLI_VERSION"

# --- Builder stage: compile TypeScript ---
FROM base AS builder

WORKDIR C:\app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY tsconfig.base.json ./
COPY packages\shared\package.json ./packages/shared/
COPY apps\workers\coder-acp-copilot\package.json ./apps/workers/coder-acp-copilot/
COPY apps\workers\coder-acp-copilot-windows\package.json ./apps/workers/coder-acp-copilot-windows/

RUN pnpm install --frozen-lockfile

COPY packages\shared\tsconfig.json ./packages/shared/
COPY packages\shared\src ./packages/shared/src/
COPY apps\workers\coder-acp-copilot\tsconfig.json ./apps/workers/coder-acp-copilot/
COPY apps\workers\coder-acp-copilot\src ./apps/workers/coder-acp-copilot/src/
COPY apps\workers\coder-acp-copilot-windows\tsconfig.json ./apps/workers/coder-acp-copilot-windows/
COPY apps\workers\coder-acp-copilot-windows\src ./apps/workers/coder-acp-copilot-windows/src/

RUN pnpm --filter shared build && pnpm --filter coder-acp-copilot build && pnpm --filter coder-acp-copilot-windows build

# --- Production stage ---
FROM base

WORKDIR C:\app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages\shared\package.json ./packages/shared/
COPY apps\workers\coder-acp-copilot\package.json ./apps/workers/coder-acp-copilot/
COPY apps\workers\coder-acp-copilot-windows\package.json ./apps/workers/coder-acp-copilot-windows/

RUN pnpm install --frozen-lockfile --prod

COPY --from=builder C:\app\packages\shared\dist ./packages/shared/dist/
COPY --from=builder C:\app\apps\workers\coder-acp-copilot\dist ./apps/workers/coder-acp-copilot/dist/
COPY --from=builder C:\app\apps\workers\coder-acp-copilot-windows\dist ./apps/workers/coder-acp-copilot-windows/dist/

# Create workspace directory for coding agents
RUN New-Item -ItemType Directory -Force -Path C:\workspace

WORKDIR C:\app\apps\workers\coder-acp-copilot-windows

# Expose component versions + build metadata at runtime (used by self-registration)
ARG GIT_COMMIT=unknown
ARG BUILD_TIME=unknown
ENV COPILOT_CLI_VERSION=$COPILOT_CLI_VERSION
ENV GIT_COMMIT=$GIT_COMMIT
ENV BUILD_TIME=$BUILD_TIME
ENV WORKER_NAME=coder-acp-copilot-windows

SHELL ["cmd", "/S", "/C"]
CMD ["node", "dist/index.js"]
