ARG COPILOT_CLI_VERSION

# --- Base stage: runtime tools shared by dev and production ---
# Windows Server Core LTSC 2022 with Node.js 24 installed via direct download.
# PowerShell is available natively — no manual install needed.
# uv and git are installed via Chocolatey (pre-installed on servercore).
FROM mcr.microsoft.com/windows/servercore:ltsc2022 AS base

SHELL ["powershell", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]

# Install Chocolatey
RUN Set-ExecutionPolicy Bypass -Scope Process -Force; \
    [System.Net.ServicePointManager]::SecurityProtocol = [System.Net.ServicePointManager]::SecurityProtocol -bor 3072; \
    iex ((New-Object System.Net.WebClient).DownloadString('https://community.chocolatey.org/install.ps1'))

# Install Node.js 24, git, and Python via Chocolatey
RUN choco install -y nodejs-lts --version 24.0.0; \
    choco install -y git --version 2.47.1; \
    choco install -y python3 --version 3.12.8

# Install pnpm via corepack (bundled with Node.js)
RUN corepack enable && corepack prepare pnpm@10.29.1 --activate

# Install uv (Python package manager) for Windows
RUN $env:UV_VERSION = '0.10.0'; \
    Invoke-WebRequest -Uri "https://github.com/astral-sh/uv/releases/download/${env:UV_VERSION}/uv-x86_64-pc-windows-msvc.zip" \
      -OutFile C:\uv.zip; \
    Expand-Archive -Path C:\uv.zip -DestinationPath C:\uv; \
    Remove-Item C:\uv.zip

ENV PATH="C:\uv;C:\Program Files\nodejs;C:\Program Files\Git\cmd;C:\Python312;C:\ProgramData\chocolatey\bin;${PATH}"

# --- Builder stage: compile TypeScript ---
FROM base AS builder

WORKDIR C:\app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY tsconfig.base.json ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/workers/coder-acp-copilot/package.json ./apps/workers/coder-acp-copilot/

RUN pnpm install --frozen-lockfile

COPY packages/shared/tsconfig.json ./packages/shared/
COPY packages/shared/src ./packages/shared/src/
COPY apps/workers/coder-acp-copilot/tsconfig.json ./apps/workers/coder-acp-copilot/
COPY apps/workers/coder-acp-copilot/src ./apps/workers/coder-acp-copilot/src/

RUN pnpm --filter shared build && pnpm --filter coder-acp-copilot build

# --- Dev stage: hot reload with tsx watch ---
FROM builder AS dev
ARG COPILOT_CLI_VERSION
RUN npm install -g @github/copilot@${COPILOT_CLI_VERSION}

RUN New-Item -ItemType Directory -Force -Path C:\workspace

ENV NODE_ENV=development
ENV SERVICE_DIR=workers/coder-acp-copilot
ENV WORKER_NAME=coder-acp-copilot-windows

WORKDIR C:\app\apps\workers\coder-acp-copilot
COPY scripts/dev-entrypoint.ps1 C:\app\scripts\dev-entrypoint.ps1
COPY config C:\app\config\

CMD ["powershell", "-File", "C:\\app\\scripts\\dev-entrypoint.ps1"]

# --- Production stage ---
FROM base

ARG COPILOT_CLI_VERSION
RUN npm install -g @github/copilot@${COPILOT_CLI_VERSION}

WORKDIR C:\app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/workers/coder-acp-copilot/package.json ./apps/workers/coder-acp-copilot/

RUN pnpm install --frozen-lockfile --prod

COPY --from=builder C:\app\packages\shared\dist ./packages/shared/dist/
COPY --from=builder C:\app\apps\workers\coder-acp-copilot\dist ./apps/workers/coder-acp-copilot/dist/

RUN New-Item -ItemType Directory -Force -Path C:\workspace

WORKDIR C:\app\apps\workers\coder-acp-copilot

ARG GIT_COMMIT=unknown
ARG BUILD_TIME=unknown
ENV COPILOT_CLI_VERSION=$COPILOT_CLI_VERSION
ENV GIT_COMMIT=$GIT_COMMIT
ENV BUILD_TIME=$BUILD_TIME
ENV WORKER_NAME=coder-acp-copilot-windows

CMD ["node", "dist/index.js"]
